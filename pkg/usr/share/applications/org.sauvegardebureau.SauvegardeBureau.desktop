[Desktop Entry]
Type=Application
Name=Desktop Backup
Name[fr]=Sauvegarde du bureau
Comment=Back up and restore applications, GNOME extensions and settings
Comment[fr]=Sauvegarder et restaurer applications, extensions GNOME et réglages
Exec=sauvegarde-bureau %F
Icon=sauvegarde-bureau
Terminal=false
Categories=GNOME;GTK;Utility;System;
Keywords=backup;restore;extensions;settings;
Keywords[fr]=sauvegarde;backup;restaurer;extensions;réglages;
StartupNotify=true
MimeType=application/x-sauvegarde-bureau;
