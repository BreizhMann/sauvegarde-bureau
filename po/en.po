msgstr "ALERT: cloud copy {v1}: {v2}"

msgid "ALERTE : le mot de passe du trousseau n'ouvre pas {v1} ({v2})."
msgstr "ALERT: the keyring password does not open {v1} ({v2})."

msgid "ALERTE : {v1} est abîmée ({msg})."
msgstr "ALERT: {v1} is damaged ({msg})."

